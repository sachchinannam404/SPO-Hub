{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPO-Hub Footer Links List Schema",
  "list": {
    "title": "Footer Links",
    "url": "Lists/FooterLinks",
    "template": 100,
    "description": "Site footer links for SPO-Hub Application Customizer",
    "enableVersioning": false
  },
  "fields": [
    { "internalName": "Title", "displayName": "Title", "type": "Text", "required": true, "maxLength": 255 },
    { "internalName": "Link", "displayName": "Link", "type": "URL", "required": true },
    { "internalName": "Url", "displayName": "Url", "type": "Text", "required": false, "maxLength": 2000 },
    {
      "internalName": "Category",
      "displayName": "Category",
      "type": "Choice",
      "required": false,
      "choices": ["Company", "Legal", "Support", "Resources", "Social"],
      "fillInChoice": true
    },
    { "internalName": "DisplayOrder", "displayName": "Display Order", "type": "Number", "required": false, "default": 100 },
    { "internalName": "IsActive", "displayName": "Is Active", "type": "Boolean", "required": false, "default": true },
    { "internalName": "OpenInNewTab", "displayName": "Open in new tab", "type": "Boolean", "required": false, "default": true },
    { "internalName": "IconName", "displayName": "Icon Name", "type": "Text", "required": false, "maxLength": 100 },
    { "internalName": "Description", "displayName": "Description", "type": "Note", "required": false }
  ],
  "views": [
    {
      "title": "All Links",
      "default": true,
      "viewFields": ["Title", "Link", "Category", "DisplayOrder", "IsActive", "OpenInNewTab"]
    },
    {
      "title": "Active Links",
      "default": false,
      "viewFields": ["Title", "Link", "Category", "DisplayOrder"]
    }
  ]
}
