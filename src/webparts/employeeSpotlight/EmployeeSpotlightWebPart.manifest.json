{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "a5b6c7d8-e9f0-1234-abcd-567890123ef0",
  "alias": "EmployeeSpotlightWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46db-9951-df6df2897b84",
      "group": { "default": "SPO-Hub" },
      "title": { "default": "Employee Spotlight" },
      "description": {
        "default": "Recognize employees, SMEs, new joiners and champions from a SharePoint list."
      },
      "officeFabricIconFontName": "ReminderPerson",
      "properties": {
        "dataSource": {
          "itemLimit": 12,
          "fieldMapping": {
            "employeeNameField": "EmployeeName",
            "jobTitleField": "JobTitle",
            "departmentField": "Department",
            "imageField": "Photo",
            "achievementField": "Achievement",
            "isActiveField": "IsActive"
          }
        },
        "display": { "columns": 3, "showDescription": true },
        "behavior": { "enableSearch": true },
        "personalization": { "enableAudienceTargeting": false }
      }
    }
  ]
}
