{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "e3f4a5b6-c7d8-9012-efab-345678901cde",
  "alias": "AccordionWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46db-9951-df6df2897b84",
      "group": { "default": "SPO-Hub" },
      "title": { "default": "List-Based Accordion" },
      "description": {
        "default": "SharePoint list-driven accordion for FAQs, policies, procedures and knowledge articles."
      },
      "officeFabricIconFontName": "CollapseContent",
      "properties": {
        "dataSource": {
          "itemLimit": 50,
          "orderBy": "DisplayOrder",
          "orderDirection": "asc",
          "fieldMapping": {
            "titleField": "Title",
            "contentField": "Content",
            "categoryField": "Category",
            "orderField": "DisplayOrder",
            "isActiveField": "IsActive"
          }
        },
        "display": { "layout": "list" },
        "behavior": {
          "enableSearch": true,
          "allowMultipleExpanded": false,
          "expandFirstItem": true
        },
        "personalization": { "enableAudienceTargeting": false }
      }
    }
  ]
}
