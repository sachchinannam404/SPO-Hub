{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "d2e3f4a5-b6c7-8901-defa-234567890bcd",
  "alias": "TimelineWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46db-9951-df6df2897b84",
      "group": { "default": "SPO-Hub" },
      "title": { "default": "Vertical Timeline" },
      "description": {
        "default": "List-driven vertical timeline for roadmaps, milestones, adoption journeys and release plans."
      },
      "officeFabricIconFontName": "Timeline",
      "properties": {
        "dataSource": {
          "itemLimit": 50,
          "orderBy": "Sequence",
          "orderDirection": "asc",
          "fieldMapping": {
            "titleField": "Title",
            "descriptionField": "Description",
            "startDateField": "StartDate",
            "endDateField": "EndDate",
            "statusTimelineField": "Status",
            "categoryField": "Category",
            "sequenceField": "Sequence",
            "isActiveField": "IsActive"
          }
        },
        "display": {
          "layout": "list"
        },
        "behavior": {},
        "personalization": {
          "enableAudienceTargeting": false
        },
        "compact": false
      }
    }
  ]
}
