{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
  "id": "c7d8e9f0-a1b2-3456-cdef-789012345a12",
  "alias": "ChartsWebPart",
  "componentType": "WebPart",
  "version": "*",
  "manifestVersion": 2,
  "requiresCustomScript": false,
  "supportedHosts": ["SharePointWebPart", "TeamsPersonalApp", "TeamsTab", "SharePointFullPage"],
  "supportsThemeVariants": true,
  "preconfiguredEntries": [
    {
      "groupId": "5c03119e-3074-46db-9951-df6df2897b84",
      "group": { "default": "SPO-Hub" },
      "title": { "default": "List-Based Charts" },
      "description": {
        "default": "Generic SharePoint list-driven charts for adoption metrics, automation KPIs and engagement analytics."
      },
      "officeFabricIconFontName": "BarChartVertical",
      "properties": {
        "dataSource": {
          "itemLimit": 200,
          "fieldMapping": {
            "titleField": "Title",
            "categoryField": "Category"
          }
        },
        "display": {
          "title": "Analytics"
        },
        "chartConfig": {
          "chartType": "bar",
          "categoryField": "Category",
          "series": [
            {
              "field": "Value",
              "aggregation": "sum",
              "label": "Value"
            }
          ],
          "showLegend": true,
          "showTitle": true
        }
      }
    }
  ]
}
